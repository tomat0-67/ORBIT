{
  "name": "orbit",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --filter @orbit/web dev",
    "build": "pnpm --filter @orbit/web build",
    "test": "pnpm --filter @orbit/web test",
    "typecheck": "pnpm --filter @orbit/web typecheck",
    "desktop:dev": "pnpm --filter @orbit/desktop tauri dev",
    "desktop:compile": "pnpm --filter @orbit/desktop tauri build --no-bundle",
    "desktop:build": "pnpm --filter @orbit/desktop tauri build"
  }
}
